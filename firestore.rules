rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 2026-09-26 不正対策（端末の日付を動かして 1日1回ものを何度も回す）: 日付フィールドはサーバー時刻の日本時間「今日」だけ書ける／ポイントは1回の書き込みで +1000 まで
    function jst() { return request.time + duration.value(9, 'h'); }
    function jstDate() { return string(jst().year()) + "-" + (jst().month() < 10 ? "0" : "") + string(jst().month()) + "-" + (jst().day() < 10 ? "0" : "") + string(jst().day()); }
    function changed() { return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys(); }
    function dayOk(k) { return !(k in changed()) || (k in request.resource.data && request.resource.data[k] == jstDate()); }
    // 2026-10-14 監査対応: ポイント増は「正当な理由」の合計まで（ルーレット10・ガチャ100・ログイン1・来店20〔未同期2件まで〕・ランク500〔各ランクの来店数を満たすときだけ〕・キャンペーン500・紹介50/件・紹介された50・投稿20）。初回作成（resource==null）は従来どおり 1000 まで。学校対抗の報酬は admin が increment で加算（本人は書かない）
    function inc() { return request.resource.data.get("points", 0) - (resource == null ? 0 : resource.data.get("points", 0)); }
    function ch(k) { return k in changed(); }
    function oldM(k) { return resource == null ? {} : resource.data.get(k, {}); }
    function newM(k) { return request.resource.data.get(k, {}); }
    function oldL(k) { return resource == null ? [] : resource.data.get(k, []); }
    function newL(k) { return request.resource.data.get(k, []); }
    function keepsOld(k) { return resource == null || !ch(k) || (newM(k) is map && newM(k).keys().hasAll(oldM(k).keys())); }
    function refBackOk() { return resource == null || !ch("referredBy") || oldM("referredBy").get("status", "") != "qualified" || newM("referredBy").get("status", "") == "qualified"; }
    function mapGrew1(k) { return resource == null || !ch(k) || (newM(k) is map && newM(k).size() == oldM(k).size() + 1 && newM(k).diff(oldM(k)).affectedKeys().size() == 1); }
    function rankNeed(k, n) { return !(k in newM("rankBonus")) || (k in oldM("rankBonus")) || newL("visits").size() >= n; }
    function rankOk() { return resource == null || !ch("rankBonus") || (mapGrew1("rankBonus") && newM("rankBonus").keys().hasOnly(["silver", "gold", "rainbow", "king", "founder"]) && rankNeed("silver", 5) && rankNeed("gold", 15) && rankNeed("rainbow", 40) && rankNeed("king", 100) && rankNeed("founder", 200)); }
    function claimOk() { return resource == null || !ch("claimed") || (mapGrew1("claimed") && newM("claimed").size() <= 10); }
    function refAdded() { return (resource == null || !ch("refClaimed")) ? 0 : (newM("refClaimed") is map && newM("refClaimed").size() <= 10 && newM("refClaimed").size() > oldM("refClaimed").size() ? newM("refClaimed").size() - oldM("refClaimed").size() : -1000); }
    function referredNow() { return ch("referredBy") && newM("referredBy").get("status", "") == "qualified" && oldM("referredBy").get("status", "") != "qualified" && exists(/databases/$(database)/documents/kakiapp_referrals/$(request.auth.uid)) && get(/databases/$(database)/documents/kakiapp_referrals/$(request.auth.uid)).data.get("status", "") == "qualified"; }
    function lastOld() { return oldL("visits").size() == 0 ? "" : oldL("visits")[oldL("visits").size() - 1]; }
    // visits は「最後の古い日付より後の日付」を1〜2件だけ足せる（同じ日付の重複・過去日の追加は不可）。足すときは qrDate が今日（＝来店チェックイン済み）
    function isDay(v) { return v is string && v.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"); }
    // visits を増やせるのは「qrDate が今日に変わる書き込み」1回だけ（ジェミ 10/14）。足せるのは 1〜2件・いずれも YYYY-MM-DD 形・最後の古い日付より後・末尾は今日
    function visitsOk() { return resource == null || !ch("visits") || (newL("visits") is list && request.resource.data.get("qrDate", "") == jstDate() && resource.data.get("qrDate", "") != jstDate() && newL("visits")[newL("visits").size() - 1] == jstDate() && ((newL("visits").size() == oldL("visits").size() + 1 && newL("visits")[oldL("visits").size()] > lastOld()) || (newL("visits").size() == oldL("visits").size() + 2 && isDay(newL("visits")[oldL("visits").size()]) && newL("visits")[oldL("visits").size()] > lastOld() && newL("visits")[oldL("visits").size()] < jstDate()))); }
    function pointsOk() { return inc() <= 0 || (resource == null && inc() <= 1000) || (rankOk() && claimOk() && visitsOk() && refAdded() >= 0 && inc() <= (ch("rouletteDate") ? 10 : 0) + (ch("gachaDate") ? 100 : 0) + (ch("loginDate") ? 1 : 0) + (ch("visits") ? 20 : 0) + (ch("rankBonus") ? 500 : 0) + (ch("claimed") ? 500 : 0) + 50 * refAdded() + (referredNow() ? 50 : 0) + (ch("boardDate") ? 20 : 0)); }
    // ---- 案（2026-10-15 調査用・未公開）: 1000式の上限に当たらないよう、changed()・jstDate()・inc を1回だけ計算して引数で渡す ----
    function uDay(c, t, k) { return !(k in c) || (k in request.resource.data && request.resource.data[k] == t); }
    function uKeep(c, k) { return resource == null || !(k in c) || (newM(k) is map && newM(k).keys().hasAll(oldM(k).keys())); }
    function uGrew1(c, k) { return resource == null || !(k in c) || (newM(k) is map && newM(k).size() == oldM(k).size() + 1 && newM(k).diff(oldM(k)).affectedKeys().size() == 1); }
    // 2026-11-11 1000式対策（意味は前と同じ）: rankBonus の新旧と visits の件数を1回だけ取り出して渡す（前は rankNeed のたびに取り直していた）
    function rankAdd(nr, orb, nv) { return nr is map && nr.size() == orb.size() + 1 && nr.diff(orb).affectedKeys().size() == 1 && nr.keys().hasOnly(["silver", "gold", "rainbow", "king", "founder"]) && rankNeed2(nr, orb, nv, "silver", 5) && rankNeed2(nr, orb, nv, "gold", 15) && rankNeed2(nr, orb, nv, "rainbow", 40) && rankNeed2(nr, orb, nv, "king", 100) && rankNeed2(nr, orb, nv, "founder", 200); }
    function rankNeed2(nr, orb, nv, k, n) { return !(k in nr) || (k in orb) || nv >= n; }
    function uRank(c) { return resource == null || !("rankBonus" in c) || rankAdd(newM("rankBonus"), oldM("rankBonus"), newL("visits").size()); }
    function uClaim(c) { return resource == null || !("claimed" in c) || (uGrew1(c, "claimed") && newM("claimed").size() <= 10); }
    function uRefBack(c) { return resource == null || !("referredBy" in c) || oldM("referredBy").get("status", "") != "qualified" || newM("referredBy").get("status", "") == "qualified"; }
    function uRefAdded(c) { return (resource == null || !("refClaimed" in c)) ? 0 : (newM("refClaimed") is map && newM("refClaimed").size() <= 10 && newM("refClaimed").size() > oldM("refClaimed").size() ? newM("refClaimed").size() - oldM("refClaimed").size() : -1000); }
    function uReferredNow(c) { return "referredBy" in c && newM("referredBy").get("status", "") == "qualified" && oldM("referredBy").get("status", "") != "qualified" && exists(/databases/$(database)/documents/kakiapp_referrals/$(request.auth.uid)) && get(/databases/$(database)/documents/kakiapp_referrals/$(request.auth.uid)).data.get("status", "") == "qualified"; }
    function uVisitsAdd(t, nv, ov, last) { return nv is list && request.resource.data.get("qrDate", "") == t && resource.data.get("qrDate", "") != t && nv[nv.size() - 1] == t && ((nv.size() == ov.size() + 1 && nv[ov.size()] > last) || (nv.size() == ov.size() + 2 && isDay(nv[ov.size()]) && nv[ov.size()] > last && nv[ov.size()] < t)); }
    function uVisits(c, t) { return resource == null || !("visits" in c) || uVisitsAdd(t, newL("visits"), oldL("visits"), lastOld()); }
    function uPoints(c, inc) { let ra = uRefAdded(c); return inc <= 0 || (resource == null && inc <= 1000) || (ra >= 0 && inc <= ("rouletteDate" in c ? 10 : 0) + ("gachaDate" in c ? 100 : 0) + ("loginDate" in c ? 1 : 0) + ("visits" in c ? 20 : 0) + ("rankBonus" in c ? 500 : 0) + ("claimed" in c ? 500 : 0) + 50 * ra + (uReferredNow(c) ? 50 : 0) + ("boardDate" in c ? 20 : 0)); }
    function userWriteOk() {
      let c = changed();
      let t = jstDate();
      let inc = request.resource.data.get("points", 0) - (resource == null ? 0 : resource.data.get("points", 0));
      return !c.hasAny(["awards", "qrRequired"]) && uDay(c, t, "rouletteDate") && uDay(c, t, "gachaDate") && uDay(c, t, "loginDate") && uDay(c, t, "qrDate") && uDay(c, t, "boardDate") && uDay(c, t, "teamVisitDay")
        && uVisits(c, t) && uRank(c) && uClaim(c) && uKeep(c, "rankBonus") && uKeep(c, "claimed") && uKeep(c, "refClaimed") && uRefBack(c) && uPoints(c, inc) && uTeam(c) && uJoinDay(c) && uHours(c, t);
    }
    function userDoc(u) { return /databases/$(database)/documents/kakiapp_users/$(u); }
    function monthKey() { return string(jst().year()) + "-" + (jst().month() < 10 ? "0" : "") + string(jst().month()); }
    // 学校の来店+1: 本人の会員データの teamVisitDay が「今日」に変わる同じ batch の中だけ（＝1日1回）。2026-10 は 10/15 開始
    // 旧ビルド（本人データと同一 batch でない学校+1）は通さない＝同日の繰り返しを許さないため（エル 10/14 3回目）。旧ビルドは次のアプリ更新で新方式になる
    // 2026-10-24 masa「締切後の学校登録そのものも止める」: 第0回の締切 10/22 のあと（10/23 00:00〜11/1 00:00 日本時間）は、学校を新しく作る・学校に入る（members+1）を受け付けない。抜ける（-1）と来店の加算はそのまま。11月のシーズンが決まったら日付を足す
    // 2026-11-01 抜け道③（masa 🇦）: 本番は毎月16日0時（日本時間）〜月末がエントリー締切中（10月お試しの日付固定から変更）
    function teamEntryClosed() { return jst().day() >= 16; }
    // 学校を新しく選ぶ書き込みは、参加時刻 teamJoinedAt（スマホの時計・世界標準時）の日付がサーバーの今日（世界標準時）と同じときだけ＝スマホの日付を戻して締切を抜けられない（古いアプリ版もこの項目は送っている）
    function utcDate() { return string(request.time.year()) + "-" + (request.time.month() < 10 ? "0" : "") + string(request.time.month()) + "-" + (request.time.day() < 10 ? "0" : "") + string(request.time.day()); }
    function uJoinDay(c) { return !("teamId" in c) || request.resource.data.get("teamId", "") == "" || (request.resource.data.get("teamJoinedAt", "") is string && request.resource.data.get("teamJoinedAt", "").matches(utcDate() + "T.*")); }
    // 2026-11-11 masa 承認（ずんだ部屋 🇦「OK・公開して」）: 来店チェックイン（qrDate が今日に変わる／visits・storeVisits が増える書き込み）は、lastStore が店の id で、
    //   その店の営業時間（開店15分前〜閉店30分後・日本時間・サーバー時刻）の中だけ受け付ける＝食べていない時間の来店ポイントを止める。端末の時計は見ない
    //   長岡本店: 毎日 11:00〜14:30／17:00〜20:15（不定休＝曜日の制限なし）→ 10:45〜15:00／16:45〜20:45
    //   仙台連坊店: 火木金土 11:00〜14:15／18:00〜23:00・水日 11:00〜14:15 のみ・月曜定休 → 10:45〜14:45／（火木金土）17:45〜23:30
    //   正典 kakigawatei-aeo/entity_dictionary.md（2026-10-20）。営業時間が変わったらここと config.js の stores[].hours を同じ日に直す
    //   dayOfWeek(): 1=月 … 7=日。mi＝0:00 からの通算分（10:45 = 645）
    function openAt(st, j) { let mi = j.hours() * 60 + j.minutes(); return st == "nagaoka" ? ((mi >= 645 && mi <= 900) || (mi >= 1005 && mi <= 1245)) : (st == "sendai" && j.dayOfWeek() != 1 && ((mi >= 645 && mi <= 885) || (j.dayOfWeek() in [2, 4, 5, 6] && mi >= 1065 && mi <= 1410))); }
    // 2026-11-11 masa 🇦「怪しい人＋5回に1回だけ店内QR」: 営業時間の中でも、次のどちらかなら「店内QRのトークン」が無いと来店を保存できない
    //   (a) 運営が印を付けた人（kakiapp_users の qrRequired:true・本人は書き換え不可＝上の hasAny）
    //   (b) 抜き打ち: crc32(uid:日付:salt) が spotMax 未満（既定 "33333333"＝5回に1回）。salt は kakiapp_qr/{店} にあり利用者は読めない＝前もって当たり日を計算できない
    //   QR の中身は「kakiapp-qr:<店>:<token>」。アプリは qrTok＝"<token>:<今日>" を来店と同じ書き込みで送る（日付入り＝前の日の qrTok は使えない）
    //   kakiapp_qr/{店} がまだ無い店は従来どおり（GPS＋営業時間だけ）＝ルールを先に公開しても、admin でトークンを発行するまで何も変わらない
    //   crc32 はバイト列で返る（剰余が取れない）ので16進の文字列（大文字）にして「spotMax より小さい」で当たり＝ spotMax "33333333" で 0x33333333/2^32＝ちょうど20%。"00000000"＝抜き打ち無し・"FFFFFFFF"＝全員
    //   1000式対策: 印は request.resource 側で見る（本人は qrRequired を変えられない＝前と同じ値）・kakiapp_qr の項目は書き込み時に形を確かめているので get(..., 既定値) を使わない
    function qrDoc(st) { return /databases/$(database)/documents/kakiapp_qr/$(st); }
    function qrNeed(q, flagged, t) { return flagged || hashing.crc32(request.auth.uid + ":" + t + ":" + q.salt).toHexString() < q.spotMax; }
    function uQr(q, t) { return !qrNeed(q, request.resource.data.get("qrRequired", false), t) || request.resource.data.get("qrTok", "") == q.token + ":" + t; }
    function uOpenQr(st, t) { let p = qrDoc(st); return openAt(st, jst()) && (!exists(p) || uQr(get(p).data, t)); }
    function uHours(c, t) { return !c.hasAny(["qrDate", "visits", "storeVisits"]) || uOpenQr(request.resource.data.get("lastStore", ""), t); }
    function uTeam(c) { return !("teamId" in c && teamEntryClosed() && request.resource.data.get("teamId", "") != "" && !(resource != null && get(/databases/$(database)/documents/kakiapp_teams/$(resource.data.get("teamId", "x"))).data.get("mergedInto", "") == request.resource.data.get("teamId", ""))); }
    function teamVisitOk(teamId) { return request.auth != null && existsAfter(userDoc(request.auth.uid)) && getAfter(userDoc(request.auth.uid)).data.get("teamVisitDay", "") == jstDate() && (!exists(userDoc(request.auth.uid)) || get(userDoc(request.auth.uid)).data.get("teamVisitDay", "") != jstDate()) && getAfter(userDoc(request.auth.uid)).data.get("teamId", "") == teamId && (monthKey() != "2026-10" || jstDate() >= "2026-10-15"); }
    // 2026-10-08 みんなの一杯（写真の掲示板）用
    function isAdmin() { return request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
    function boardDoc(p) { return /databases/$(database)/documents/kakiapp_board/$(p); }
    function boardSub(p, kind) { return /databases/$(database)/documents/kakiapp_board/$(p)/$(kind)/$(request.auth.uid); }
match /announcements/{doc} {
  allow read: if true;
  allow write: if request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2";
}
match /stats_spot/{doc} { allow read: if false; allow write: if request.auth != null; }
match /stats_shop/{doc} { allow read: if false; allow write: if request.auth != null; }
match /survey_results/{doc} { allow read: if false; allow write: if request.auth != null; }
match /surveys/{doc} { allow read: if true; allow write: if false; }
    // お宝カードのシリアル番号（何番目の発見者か）
    match /cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 友達紹介コード
    match /refcodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
    }

    // 友達紹介の成立記録
    match /referrals/{referredUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && referredUid == request.auth.uid
                    && request.resource.data.referrerUid is string;
    }

    // プレイヤーの稼働記録（自分の分だけ書ける／読み取りは禁止）
    match /users/{uid} {
      allow read: if false;
      allow write: if request.auth != null && uid == request.auth.uid;
    }

    // 「このアカウントはどのお店か」の紐付け（運営がコンソールから作る）
    match /shopOwners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // お店の混雑ステータス（アプリは誰でも読める／書けるのは紐付いた店だけ）
    match /crowd/{shopId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/shopOwners/$(request.auth.uid)).data.shopId == shopId
        && request.resource.data.keys().hasOnly(['level', 'updatedAt', 'source'])
        && request.resource.data.level in ['green', 'yellow', 'red', 'off'];
    }
    
    match /shime_docs/{doc} {
      allow read, write: if request.auth != null;
    }

    // 柿川亭アプリ（ポイント）の会員データ。本人だけが自分の1件を読み書きできる
    // ＝他人のポイントは見えないし、書き換えられない


   
match /kakiapp_announcements/{doc} {
      allow read: if true;
      allow write: if request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2";
    }

match /kakiapp_users/{uid} { allow read: if request.auth != null && (request.auth.uid == uid || isAdmin()); allow delete: if isAdmin(); allow create, update: if request.auth != null && (isAdmin() || (request.auth.uid == uid && userWriteOk())); }
match /kakiapp_campaigns/{doc} { allow read: if true; allow write: if request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
match /kakiapp_teams/{doc} { allow read: if request.auth != null; allow create: if request.auth != null && !teamEntryClosed() && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.norm is string && request.resource.data.members == 1; allow update: if request.auth != null && (request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2" || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "visits", "visitsByStore", "days", "visitsTotal"]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["visits", "visitsByStore", "days", "visitsTotal"]) || teamVisitOk(doc)) && request.resource.data.visitsTotal <= resource.data.visitsTotal + 1 && request.resource.data.members <= resource.data.members + 1 && !(request.resource.data.members > resource.data.members && teamEntryClosed()) && request.resource.data.members >= resource.data.members - 1 && (!("visits" in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.visits.diff(resource.data.get("visits", {})).affectedKeys().hasOnly([string((request.time + duration.value(9, 'h')).year()) + "-" + ((request.time + duration.value(9, 'h')).month() < 10 ? "0" : "") + string((request.time + duration.value(9, 'h')).month())]) && request.resource.data.visits[string((request.time + duration.value(9, 'h')).year()) + "-" + ((request.time + duration.value(9, 'h')).month() < 10 ? "0" : "") + string((request.time + duration.value(9, 'h')).month())] <= resource.data.get("visits", {}).get(string((request.time + duration.value(9, 'h')).year()) + "-" + ((request.time + duration.value(9, 'h')).month() < 10 ? "0" : "") + string((request.time + duration.value(9, 'h')).month()), 0) + 1)) && (!("days" in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.days.diff(resource.data.get("days", {})).affectedKeys().size() <= 1) && (!("visitsByStore" in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.visitsByStore.diff(resource.data.get("visitsByStore", {})).affectedKeys().hasOnly([string((request.time + duration.value(9, 'h')).year()) + "-" + ((request.time + duration.value(9, 'h')).month() < 10 ? "0" : "") + string((request.time + duration.value(9, 'h')).month())])))); allow delete: if request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
// 2026-10-08 友だち紹介キャンペーン（案・未公開）: 紹介コードの引き当て表（本人が作るだけ・誰でも読める・書き換え/削除なし）
match /kakiapp_refcodes/{code} { allow read: if true; allow create: if request.auth != null && request.auth.uid == request.resource.data.uid && request.resource.data.keys().hasOnly(["uid", "createdAt"]); allow update, delete: if false; }
// 紹介の記録 doc id＝紹介された人の uid（1人1回）。読めるのは紹介した人・された人だけ。作るのは紹介された本人（自分以外を紹介者に・pending で）。
// 変更は紹介された本人が pending→qualified にするだけ（qualifiedAt 以外は変えられない）。期限＝2026-10-31 日本時間いっぱい（= 2026-10-31 15:00 UTC）。config.js の referral.until と揃える
match /kakiapp_referrals/{refereeId} { allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.referrer || request.auth.uid == resource.data.referee); allow create: if request.auth != null && request.auth.uid == refereeId && request.resource.data.referee == refereeId && request.resource.data.referrer is string && request.resource.data.referrer != refereeId && request.resource.data.status == "pending" && request.resource.data.keys().hasOnly(["referrer", "referee", "code", "createdAt", "status"]) && request.time < timestamp.date(2026, 10, 31) + duration.value(15, 'h'); allow update: if request.auth != null && request.auth.uid == refereeId && resource.data.referee == refereeId && resource.data.status == "pending" && request.resource.data.status == "qualified" && changed().hasOnly(["status", "qualifiedAt"]) && request.time < timestamp.date(2026, 10, 31) + duration.value(15, 'h'); allow delete: if false; }
match /kakiapp_settings/{doc} { allow read: if true; allow write: if request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
// 2026-11-11 店内QR（抜き打ち）: トークンと salt の正本。読める・書けるのは運営だけ（利用者はトークンを盗めない。ルールの get() は読み取り権限と無関係に読める）
match /kakiapp_qr/{st} { allow read, delete: if isAdmin(); allow create, update: if isAdmin() && request.resource.data.token is string && request.resource.data.token.size() >= 16 && request.resource.data.salt is string && request.resource.data.spotMax is string && request.resource.data.spotMax.matches("^[0-9A-F]{8}$"); }
// 問い合わせ用（doc は作らない・読むだけ）。読めた＝はい／拒否＝いいえ。
//   need/{uid}: 今日この店で QR が要るか（本人だけ）。tok/{token}: 読んだ QR のトークンが今のものか（16文字以上のランダムなので総当たりは不可）
match /kakiapp_qrcheck/{st}/need/{u} { allow get: if request.auth != null && request.auth.uid == u && exists(qrDoc(st)) && qrNeed(get(qrDoc(st)).data, exists(userDoc(u)) && get(userDoc(u)).data.get("qrRequired", false) == true, jstDate()); allow list, write: if false; }
match /kakiapp_qrcheck/{st}/tok/{tk} { allow get: if request.auth != null && exists(qrDoc(st)) && get(qrDoc(st)).data.get("token", "") == tk; allow list, write: if false; }
match /kakiapp_seasons/{doc} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
// 2026-10-09 プッシュ通知（案・未公開）: 端末の FCM トークンの控え。doc id＝本人の uid。書けるのは本人の1件だけ（決まった項目・形のみ）。読めるのは本人と運営（admin の「通知ONの端末」の数）
match /kakiapp_push_tokens/{uid} { allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"); allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(["token", "platform", "enabled", "topics", "updatedAt"]) && request.resource.data.token is string && request.resource.data.token.size() <= 4096 && request.resource.data.enabled is bool && request.resource.data.platform in ["ios", "android", "web", "unknown"] && request.resource.data.topics is list && request.resource.data.topics.size() <= 5 && request.resource.data.updatedAt is string; allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"); }
    match /kakiapp_board_blocks/{uid} { allow read, delete: if request.auth != null && request.auth.uid == uid; allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(["list", "updatedAt"]) && request.resource.data.list is list && request.resource.data.list.size() <= 500 && request.resource.data.updatedAt is string; }
// 2026-10-09 プッシュ通知の下書き（案・未公開）: admin.html で運営だけが作る・読む・消す。送信はサービスアカウント（scripts/push_send.mjs）＝ルールの外で status:"sent" を付ける
match /kakiapp_push_requests/{doc} { allow read, write: if request.auth != null && request.auth.uid == "KtFyiOuMs6VcCguSKKFjLP4PUgg2"; }
// 2026-10-08 みんなの一杯（写真の掲示板・案・未公開）。投稿 doc id＝「uid_日付（日本時間）」＝1人1日1件。投稿できるのは会員データの qrDate が今日（＝来店チェックインした日）の本人だけ。
// 文字（text）は30文字まで（config.js の board.maxChars と揃える）。♥ と通報は likes/{uid}・reports/{uid} の作成（♥ は削除も）と数の ±1 を同じ batch でしか変えられない。運営は何でも直せる・消せる
match /kakiapp_board/{postId} {
  allow read: if request.auth != null;
  allow create: if request.auth != null
    && postId == request.auth.uid + "_" + jstDate()
    && request.resource.data.keys().hasOnly(["uid", "name", "text", "shop", "img", "createdAt", "day", "likes", "reports", "hidden", "igOk"])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.day == jstDate()
    && request.resource.data.text is string && request.resource.data.text.size() <= 30
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
    && request.resource.data.shop in ["nagaoka", "sendai"]
    && request.resource.data.img == "doc"
    && request.resource.data.createdAt is string
    && request.resource.data.likes == 0 && request.resource.data.reports == 0 && request.resource.data.hidden == false
    && request.resource.data.igOk is bool
    && get(/databases/$(database)/documents/kakiapp_users/$(request.auth.uid)).data.get("qrDate", "") == jstDate();
  allow update: if request.auth != null && (isAdmin()
    || (changed().hasOnly(["likes"])
        && ((request.resource.data.likes == resource.data.likes + 1 && !exists(boardSub(postId, "likes")) && existsAfter(boardSub(postId, "likes")))
         || (request.resource.data.likes == resource.data.likes - 1 && exists(boardSub(postId, "likes")) && !existsAfter(boardSub(postId, "likes")))))
    || (changed().hasOnly(["reports"])
        && request.resource.data.reports == resource.data.reports + 1 && !exists(boardSub(postId, "reports")) && existsAfter(boardSub(postId, "reports"))));
  allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
  match /likes/{likerId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null && likerId == request.auth.uid
      && request.resource.data.keys().hasOnly(["uid", "at"]) && request.resource.data.uid == likerId
      && getAfter(boardDoc(postId)).data.likes == get(boardDoc(postId)).data.likes + 1;
    allow delete: if request.auth != null && likerId == request.auth.uid
      && existsAfter(boardDoc(postId)) && getAfter(boardDoc(postId)).data.likes == get(boardDoc(postId)).data.likes - 1;
    allow update: if false;
  }
  match /reports/{reporterId} {
    allow read: if request.auth != null && (reporterId == request.auth.uid || isAdmin());
    allow create: if request.auth != null && reporterId == request.auth.uid
      && request.resource.data.keys().hasOnly(["uid", "at"]) && request.resource.data.uid == reporterId
      && getAfter(boardDoc(postId)).data.reports == get(boardDoc(postId)).data.reports + 1;
    allow update: if false;
    allow delete: if isAdmin();
  }
}
// 写真（Storage 未設定のため data URL を別 doc に）。投稿と同じ batch で本人が作るだけ（あとから差し替え不可）。jpeg の data URL・90万文字未満
match /kakiapp_board_img/{postId} {
  allow read: if request.auth != null;
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(["uid", "data", "createdAt"])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.data is string && request.resource.data.data.size() < 900000
    && request.resource.data.data.matches("^data:image/jpeg;base64,.*")
    && !exists(boardDoc(postId)) && existsAfter(boardDoc(postId)) && getAfter(boardDoc(postId)).data.uid == request.auth.uid;
  allow update: if false;
  allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
}
match /sugoroku_players/{uid} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid; }
match /sugoroku_props/{doc} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.owner == request.auth.uid; allow update: if request.auth != null && resource.data.owner in [null, request.auth.uid] && request.resource.data.owner == request.auth.uid; allow delete: if request.auth != null && resource.data.owner == request.auth.uid; }
match /sugoroku_games/{doc} { allow read, write: if request.auth != null; }

match /sugoroku_matches/{matchId} { allow read: if request.auth != null && request.auth.uid in resource.data.participantUids; allow write: if false;
  match /hands/{seatId} { allow read: if request.auth != null && request.auth.uid == resource.data.uid; allow write: if false; }
  match /actions/{actionId} { allow read: if request.auth != null && request.auth.uid == resource.data.actorUid; allow write: if false; }
  match /events/{rev} { allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sugoroku_matches/$(matchId)).data.participantUids; allow write: if false; }
  match /serverState/{doc} { allow read, write: if false; }
  match /jobs/{doc} { allow read, write: if false; } }
match /sugoroku_requests/{uid}/{document=**} { allow read, write: if false; }
  // 2026-10-15 講演会用「空中戦メーター」（masa 🇦 公開OK）: スマホが自分の端末の累計タップ数だけ書く。ログイン不要。他のデータには触れない
match /kuuchuusen/{room}/phones/{cid} {
  allow read: if room.matches('^[a-z0-9-]{4,40}$');
  allow create, update: if room.matches('^[a-z0-9-]{4,40}$') && cid.matches('^[a-z0-9]{12,32}$')
    && request.resource.data.keys().hasOnly(['n', 't'])
    && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 100000
    && request.resource.data.t == request.time
    && (resource == null || request.resource.data.n >= resource.data.n);
  allow delete: if false;
}
  }
}
