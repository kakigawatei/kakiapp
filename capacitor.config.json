{
  "appId": "com.kakigawatei.app",
  "appName": "柿川亭アプリ",
  "webDir": "www",
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "phone"
      ]
    }
  }
}
